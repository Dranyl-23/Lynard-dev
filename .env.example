# ==============================================================
# ALFIE LYNARD PORTFOLIO - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

# 1. Web3Forms (100% Free, Unlimited, Zero Backend Required)
# Obtain your free access key from: https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# 2. Google reCAPTCHA v2 (Spam & Bot Shield)
# Create your free key at: https://www.google.com/recaptcha/admin
# Choose: reCAPTCHA v2 -> "I'm not a robot" Checkbox
# Add domains: localhost, your-vercel-domain.vercel.app, and your custom domain
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
